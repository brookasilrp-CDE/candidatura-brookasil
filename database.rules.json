{
  "rules": {
    ".read": true,
    ".write": true,
    "candidates": {
      ".indexOn": ["status", "electionId", "office", "stateId", "cityId", "partyId", "number"]
    },
    "parties": {
      ".indexOn": ["active", "number", "group"]
    },
    "elections": {
      ".indexOn": ["status", "type"]
    },
    "auditLogs": {
      ".indexOn": ["timestamp", "electionId", "stateId"]
    },
    "notifications": {
      ".indexOn": ["timestamp", "read", "target"]
    }
  }
}
